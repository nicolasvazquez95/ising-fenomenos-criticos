@online{deoliveiraOriginsIsingModel2025,
  title = {Origins of the {{Ising}} Model},
  author = {family=Oliveira, given=Mário J., prefix=de, useprefix=true},
  date = {2025},
  doi = {10.48550/ARXIV.2509.00632},
  url = {https://arxiv.org/abs/2509.00632},
  urldate = {2026-10-31},
  abstract = {In 1925, Ernest Ising published a paper analyzing a model proposed in 1920 by Wilhelm Lenz for ferromagnetism. The model is composed of constituent units that take only two states and interact only when they are neighbors. Ising showed that in a linear chain the model does not present an ordered ferromagnetic state, a frustrating but correct result. However, Rudolf Peierls demonstrated in 1936 that the model does in fact present an ordered state in two dimensions, and therefore in three dimensions. This result reveals that short-range interaction and only two states for each constituent unit are sufficient for ordering to occur over long distances. These two elements are the key to understanding the success of the model and its variants even a hundred years after its appearance. Here we analyze the emergence of the model in the period up to 1936.},
  pubstate = {prepublished},
  version = {1},
  keywords = {FOS: Physical sciences,History and Philosophy of Physics (physics.hist-ph)}
}

